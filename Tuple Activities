# Tuple Activities 

print("=== Tuple Activities ===\n")

# Activity 1: Access Elements
print("Activity 1: Access Elements")
colors = ("red", "green", "blue")
print("First item:", colors[0])
print("Last item:", colors[-1])
print("-" * 30)

# Activity 2: Slicing
print("Activity 2: Slicing")
numbers = (10, 20, 30, 40, 50)
print("Sliced (20, 30, 40):", numbers[1:4])
print("-" * 30)

# Activity 3: Tuple Methods
print("Activity 3: Tuple Methods")
nums = (1, 2, 2, 3, 2)
print("Original tuple:", nums)
print("Count of 2:", nums.count(2))
print("Index of 3:", nums.index(3))
print("-" * 30)

# Activity 4: Tuple Packing & Unpacking
print("Activity 4: Tuple Packing & Unpacking")
point = (5, 10)
x, y = point                    # Unpacking
print("x =", x, ", y =", y)
print("-" * 30)

# Activity 5 (Challenge): Combine Tuples
print("Activity 5: Combine Tuples")
t1 = (1, 2)
t2 = (3, 4)

# Combine and repeat twice
combined = t1 + t2
result = combined * 2
print("Combined and repeated:", result)
print("-" * 30)

print("All activities completed! ")
